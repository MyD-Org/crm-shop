# Base de datos
DATABASE_URL=postgresql://usuario:password@host:5432/crm_shop
MIGRATE_DATABASE_URL=postgresql://usuario:password@host:5432/crm_shop
POSTGRES_URL=postgresql://usuario:password@host:5432/crm_shop
POSTGRES_URL_NON_POOLING=postgresql://usuario:password@host:5432/crm_shop

# Clerk (autenticación del portal)
SESSION_SECRET=changeme
OTP_SECRET=changeme
COOKIE_DOMAIN=tienda.cliente.example

# Alegra (gestión / facturación)
ALEGRA_EMAIL=usuario@ejemplo.com
ALEGRA_TOKEN=changeme
ALEGRA_BASE_URL=https://api.alegra.com/api/v1

# CRM (integración)
CRM_INTERNAL_URL=http://localhost:3000
SHOP_CRM_SECRET=changeme

# Mercado Pago (pagos)
MP_ACCESS_TOKEN=changeme
MP_WEBHOOK_SECRET=changeme
NEXT_PUBLIC_MP_PUBLIC_KEY=changeme

# R2 (almacenamiento de comprobantes)
# Configuradas en .env.local (no en .env.example por seguridad)

# Email (Resend)
RESEND_API_KEY=changeme
EMAIL_FROM=noreply@tienda.cliente.example

# Sitio
NEXT_PUBLIC_SITE_URL=https://tienda.cliente.example
SITE_AUTH_USER=changeme
SITE_AUTH_PASSWORD=changeme
FACEBOOK_DOMAIN_VERIFICATION=changeme
GEOCODE_CONTACT_EMAIL=contacto@cliente.example

# Medios de pago / hosts de imágenes
SHOP_MEDIA_HOSTS=imagen.cliente.example
HOSTS_IMAGENES=imagen.cliente.example

# Tenant (inquilino)
SHOP_TENANT_ID=central-led

# Crones
CRON_SECRET=changeme

# Debug (opcional)
DEBUG_SQL=false
NEXT_PHASE=production
NODE_ENV=production
AI_API_URL=https://ai-api.ejemplo.com
