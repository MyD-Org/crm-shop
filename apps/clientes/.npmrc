# El design system @myd-org/ui se publica en GitHub Packages, no en npmjs.
# El token se lee del entorno: nunca escribir el valor literal en este archivo
# (se commitea al repo). Necesita scope `read:packages`.
#   export GITHUB_TOKEN=<token con read:packages>
@myd-org:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
