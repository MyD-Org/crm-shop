{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true,
      "**": false
    }
  },
  "ignoreCommand": "[ \"$VERCEL_GIT_PREVIOUS_SHA\" != \"$VERCEL_GIT_COMMIT_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':!*.test.ts*' ':!*.md' ':!docs' 2>/dev/null || exit 1"
}
