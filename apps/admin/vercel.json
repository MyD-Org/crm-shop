{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- .",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/auto-return-bot",
      "schedule": "0 9 * * *"
    }
  ]
}
