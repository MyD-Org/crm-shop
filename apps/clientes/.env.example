# Variables de entorno del Shop (apps/clientes).
# Copiar a .env.local y completar. Detalle de cada una en README.md.
# (*) = obligatoria para que la app funcione. Los interruptores NO van acá:
# viven en Vercel Flags (src/flags.ts).

# --- Base de datos ---
DATABASE_URL=                 # (*) pooled, rol shop_app. Lo único que lee el runtime.
MIGRATE_DATABASE_URL=         # solo npm run db:migrate: conexión directa, dueño del esquema shop
SHOP_TENANT_ID=               # (*) tenant de la tienda; sin ella la app no arranca

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # (*)
CLERK_SECRET_KEY=                    # (*)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/ingresar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_PROXY_URL=         # opcional, solo si Clerk va por proxy

# --- Cuenta del cliente (cookie compartida con el CRM y vinculación) ---
SESSION_SECRET=               # (*) mismo valor que el CRM
COOKIE_DOMAIN=.cliente.example
OTP_SECRET=                   # (*) código de vinculación por mail

# --- Alegra ---
ALEGRA_EMAIL=                 # (*)
ALEGRA_TOKEN=                 # (*)
ALEGRA_BASE_URL=              # opcional (default: la API de producción de Alegra)

# --- CRM ---
CRM_INTERNAL_URL=http://localhost:3000   # (*) cuotas y revalidación
SHOP_CRM_SECRET=              # (*) mismo valor en el proyecto del CRM
CRM_ADMIN_URL=https://crm.plataforma.example

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# --- R2: fotos de la tienda (bucket público) ---
R2_SHOP_MEDIA_ACCOUNT_ID=     # o R2_ACCOUNT_ID
R2_SHOP_MEDIA_ACCESS_KEY_ID=
R2_SHOP_MEDIA_SECRET_ACCESS_KEY=
R2_SHOP_MEDIA_BUCKET=
R2_SHOP_MEDIA_PUBLIC_URL=https://media.plataforma.example
R2_REGION=                    # opcional

# --- R2: comprobantes de pago (bucket privado) ---
R2_RECEIPTS_ACCOUNT_ID=
R2_RECEIPTS_ACCESS_KEY_ID=
R2_RECEIPTS_SECRET_ACCESS_KEY=
R2_RECEIPTS_BUCKET=

# --- Email (Resend) ---
RESEND_API_KEY=               # (*)
EMAIL_FROM=tienda@cliente.example        # (*) dominio verificado en Resend
RECEIPTS_EMAIL_FROM=          # opcional (default: EMAIL_FROM)

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://tienda.cliente.example   # (*) canonical, sitemap, OG
SHOP_MEDIA_HOSTS=media.plataforma.example             # (*) hosts de fotos, separados por coma
GEOCODE_CONTACT_EMAIL=contacto@cliente.example        # (*) lo exige Nominatim
FACEBOOK_DOMAIN_VERIFICATION=  # token de verificación de dominio de Meta
CSP_REPORT_URI=                # opcional

# --- Cortina "Próximamente" (borrarlas abre el sitio) ---
SITE_AUTH_USER=
SITE_AUTH_PASSWORD=

# --- Crones ---
CRON_SECRET=                  # (*)

# --- Chat con el agente (flag chat-ia) ---
AI_API_URL=https://ai.plataforma.example
AI_API_KEY=
AI_AGENT_ID=

# --- Debug ---
DEBUG_SQL=                    # opcional
